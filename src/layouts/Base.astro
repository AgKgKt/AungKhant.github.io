---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import { href } from '../lib/url';
import { getImage } from 'astro:assets';
import profilePhoto from '../assets/profile-photo.jpg';

interface Props {
  title: string;
  description?: string;
  section?: 'main' | 'history';
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: string;
}

const {
  title,
  description = site.description,
  section = 'main',
  ogType = 'website',
  noindex = false,
  jsonLd,
  lang = 'en-GB',
} = Astro.props;

const isHome = Astro.url.pathname === href('/');
const fullTitle = isHome ? `${site.name} — ${site.role}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: profilePhoto, width: 400, format: 'jpg' });
const ogImage = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang={lang} data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer section={section} />
  </body>
</html>
